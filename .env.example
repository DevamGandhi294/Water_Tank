# ---- PostgreSQL ----
# Host port is 5433 because 5432 is already used by another project on this machine.
POSTGRES_DB=waterlevel
POSTGRES_USER=waterlevel
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgres://waterlevel:change_me_db_password@localhost:5433/waterlevel

# ---- pgAdmin (http://localhost:5050) ----
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password
PGADMIN_PORT=5050

# ---- Mosquitto ----
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_URL=mqtt://localhost:1883
