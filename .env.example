# Copy to .env and fill in. Used by docker-compose.yml (local dev) and
# docker-compose.prod.yml (Contabo VPS). Never commit .env.
# Make secrets with:  openssl rand -hex 32

# ---------------------------------------------------------------- domain
DOMAIN=watertank.ecobridgers.com
# public address of the API (used in firmware download links)
PUBLIC_BASE_URL=https://watertank.ecobridgers.com
# browsers allowed to call the API (the admin panel); comma separated
CORS_ORIGINS=https://watertank.ecobridgers.com
# proxies in front of the backend: host Nginx + web container = 2
TRUST_PROXY=2
# the web container listens on 127.0.0.1:WEB_PORT; the host Nginx proxies to it
WEB_PORT=8088
# where the app links people who get an invite by SMS (later)
APP_LINK=https://watertank.ecobridgers.com

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=waterlevel
POSTGRES_USER=waterlevel
POSTGRES_PASSWORD=change_me_db_password
# local dev only (host port 5433 because 5432 is taken on the dev machine)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgres://waterlevel:change_me_db_password@localhost:5433/waterlevel

# ---------------------------------------------------------------- backend secrets
JWT_SECRET=change_me_openssl_rand_hex_32
# HMAC key for claim codes and OTP codes. Changing it makes printed claim codes invalid.
HASH_PEPPER=change_me_openssl_rand_hex_32

# ---------------------------------------------------------------- MQTT (Mosquitto)
# the backend's own MQTT login; devices log in with their registered MAC (no password)
MQTT_BACKEND_USERNAME=wt-backend
MQTT_BACKEND_PASSWORD=change_me_openssl_rand_hex_32
# production: public TLS port for the ESP boards, and a plain port on 127.0.0.1 for testing
MQTT_TLS_PORT=8883
MQTT_LOCAL_PORT=1883
# local dev
MQTT_PORT=1883
MQTT_URL=mqtt://localhost:1883

# ---------------------------------------------------------------- SMS (off for now)
# none = phone + password only, no OTP codes. msg91 = send OTP / invite SMS with MSG91.
SMS_PROVIDER=none
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_INVITE_TEMPLATE_ID=
MSG91_SENDER_ID=

# ---------------------------------------------------------------- Google sign-in (off for now)
# comma separated OAuth client ids (web, Android, iOS). The endpoint returns 501 until it is built in.
GOOGLE_CLIENT_IDS=

# ---------------------------------------------------------------- Push notifications (FCM)
# path INSIDE the backend container; put the file in deploy/secrets/ on the server
FCM_SERVICE_ACCOUNT_FILE=
# e.g. FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json

# ---------------------------------------------------------------- local dev tools
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password
PGADMIN_PORT=5050
BACKEND_PORT=3000
LOG_LEVEL=info
